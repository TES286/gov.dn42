# gov.dn42 后端环境变量示例
# 复制到 /etc/gov-dn42/backend.env 并填入实际值

# 监听端口（caddy 反代到此端口）
PORT=8787

# PostgreSQL 连接串（生产）
# 格式：postgres://user:password@host:5432/dbname
PG_CONNECTION_STRING=postgres://gov_dn42:CHANGE_ME@localhost:5432/gov_dn42

# 会话 token 有效期（小时）
SESSION_TTL_HOURS=24

# OIDC client_secret（向各提供商申请）
OIDC_CLIENT_SECRET_IEDON=
OIDC_CLIENT_SECRET_G_LOAD=
OIDC_CLIENT_SECRET_HEXPNET=
